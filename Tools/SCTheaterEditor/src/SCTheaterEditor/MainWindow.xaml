<Window x:Class="SCTheaterEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SCTheaterEditor.Views"
        Title="SC Theater Editor (TE)" Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 탭 이동: Ctrl+PageUp/PageDown (무대에 포커스가 있어도 동작), 탭을 바꾸면 그 탭으로 포커스 이동 -->
    <!-- 변경: 탭 줄 오른쪽 끝에 [로그] 버튼을 겹쳐 두려고 Grid로 감쌈 -->
    <Grid>
    <TabControl x:Name="MainTabs" Margin="6" SelectionChanged="MainTabs_SelectionChanged">

        <!-- ========== 다운로드 탭 (변경: MVVM — Views/DownloadView. 변경: 아래 로그는 삭제, 로그는 로그 창으로) ========== -->
        <TabItem x:Name="DownloadTab" Header="다운로드">
            <views:DownloadView DataContext="{Binding Download}"/>
        </TabItem>

        <!-- ========== 리소스 탭 (변경: MVVM — 트리 대신 의상 종류 구분선이 있는 목록) ========== -->
        <TabItem x:Name="ResourceTab" Header="리소스">
            <views:ResourceView x:Name="ResourcePage" DataContext="{Binding Resource}"/>
        </TabItem>

        <!-- ========== 스크립트 탭 (3회차: 뷰어 탭을 대체 — 1920×1080 무대 + 선택 캐릭터 패널, 4회차에 스크립트 표) ========== -->
        <TabItem x:Name="ScriptTab" Header="스크립트">
            <views:ScriptView x:Name="ScriptPage" DataContext="{Binding Script}"/>
        </TabItem>

        <!-- ========== 라이선스 탭 ========== -->
        <TabItem x:Name="LicenseTab" Header="라이선스">
            <TextBox x:Name="LicenseBox" Margin="6" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </TabItem>

    </TabControl>

    <!-- 추가: 로그 창 열기/닫기 -->
    <Button Content="로그 (Ctrl+L)" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,12,0" Padding="8,1"
            Click="LogButton_Click" ToolTip="로그를 따로 움직이는 창으로 보기 — 어느 탭에서든"/>
    </Grid>
</Window>
