<Window x:Class="SCTheaterEditor.Views.VoiceBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TEXT에 보이스 일괄 추가" Width="820" Height="560" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- 추가(9회차): DataContext = VoiceBatchViewModel. 방식을 바꾸면 목록을 바로 다시 계산, [적용] = DialogResult true -->
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding FolderText}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="VoiceBatchMode" Content="1. 덮어쓰기 — 선택한 TEXT 줄 전부" Margin="0,0,16,0"
                             IsChecked="{Binding IsOverwrite}" ToolTip="기존 Voice가 있어도 바꿈 (화자 없는 줄은 건너뜀)"/>
                <RadioButton GroupName="VoiceBatchMode" Content="2. 빈 줄에만 — Voice가 빈 TEXT 줄"
                             IsChecked="{Binding IsEmptyOnly}" ToolTip="Voice가 있는 줄은 건너뛰고 보이스도 쓰지 않음 (화자 없는 줄도 건너뜀)"/>
            </StackPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="적용" Width="80" Margin="0,0,8,0" IsDefault="True" IsEnabled="{Binding CanApply}" Click="Apply_Click"/>
                <Button Content="취소" Width="80" IsCancel="True"/>
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       ToolTip="되돌리기(Ctrl+Z) 한 번으로 모두 되돌릴 수 있습니다"/>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFE0E0E0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Changes}" Value="False">
                            <Setter Property="Foreground" Value="#FF999999"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="줄" Binding="{Binding Number}" Width="44"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="90"/>
                <DataGridTextColumn Header="대사" Binding="{Binding Text}" Width="*"/>
                <DataGridTextColumn Header="지금 Voice" Binding="{Binding OldVoice}" Width="120"/>
                <DataGridTextColumn Header="→ 넣을 Voice" Binding="{Binding NewVoice}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
