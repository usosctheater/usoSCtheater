<UserControl x:Class="SCTheaterEditor.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SCTheaterEditor.Views">
    <!-- 다운로드 탭. DataContext = DownloadViewModel (로그는 MainWindow가 LogView를 아래에 붙임) -->
    <DockPanel Margin="6">

        <!-- 상단: 저장 폴더 / 목록 갱신 / 받기 / 중지 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="저장 폴더:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding SaveFolder, Mode=OneTime}" Width="380" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button Content="폴더 열기" Margin="6,0,0,0" Padding="10,2" Command="{Binding OpenFolderCommand}"/>
            <Button Content="목록 갱신 (서버)" Margin="16,0,0,0" Padding="10,2" Command="{Binding RefreshCommand}"
                    ToolTip="idollist + 아이돌별 dresslist를 받아 스냅샷을 갱신합니다 (요청 약 34회, 1초 간격)"/>
            <Button Content="체크한 아이돌 받기" Margin="16,0,0,0" Padding="10,2" Command="{Binding DownloadCheckedCommand}"
                    ToolTip="아이돌 필터에서 켠 아이돌의 세트 중 아직 받지 않은 것만 받습니다 (검색어와 무관)"/>
            <Button Content="전체 받기" Margin="6,0,0,0" Padding="10,2" Command="{Binding DownloadAllCommand}"
                    ToolTip="아직 받지 않은 모든 세트를 받습니다"/>
            <Button Content="중지" Margin="6,0,0,0" Padding="10,2" Command="{Binding CancelCommand}"/>
            <TextBlock Text="{Binding SnapshotText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 진행 표시 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{Binding ProgressText}" DockPanel.Dock="Right" Width="420" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <ProgressBar Height="14" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}"/>
        </DockPanel>

        <!-- 요약 -->
        <TextBlock Text="{Binding SummaryText}" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"/>

        <!-- 아이돌 필터 (유닛 드롭다운 → 멤버) -->
        <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,6">
            <views:IdolFilterView DataContext="{Binding Filter}"/>
        </Border>

        <!-- 건너뛴 항목 / 충돌 -->
        <Expander DockPanel.Dock="Bottom" Header="{Binding SkippedHeader}" Margin="0,6,0,0">
            <DataGrid ItemsSource="{Binding Skipped}" Height="150" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="90"/>
                    <DataGridTextColumn Header="idolId" Binding="{Binding IdolId}" Width="60"/>
                    <DataGridTextColumn Header="enzaId" Binding="{Binding EnzaId}" Width="100"/>
                    <DataGridTextColumn Header="의상명" Binding="{Binding DressName}" Width="*"/>
                    <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- 검색 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" VerticalContentAlignment="Center"
                     ToolTip="아이돌·의상명·파일명·경로에서 검색 (공백으로 여러 단어)"/>
        </DockPanel>

        <!-- 받을 세트 목록 -->
        <DataGrid ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="60"/>
                <DataGridTextColumn Header="아이돌" Binding="{Binding IdolName}" Width="110"/>
                <DataGridTextColumn Header="의상 종류" Binding="{Binding DressType}" Width="90"/>
                <DataGridTextColumn Header="의상명" Binding="{Binding DressName}" Width="2*"/>
                <DataGridTextColumn Header="그룹" Binding="{Binding Group}" Width="120"/>
                <DataGridTextColumn Header="파일명" Binding="{Binding BaseName}" Width="1.5*"/>
                <DataGridTextColumn Header="복사" Binding="{Binding CopyText}" Width="45"/>
                <DataGridTextColumn Header="서버 경로" Binding="{Binding SourcePath}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
