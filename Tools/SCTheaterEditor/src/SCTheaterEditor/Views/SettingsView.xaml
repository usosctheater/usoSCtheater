<UserControl x:Class="SCTheaterEditor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 추가: 설정 탭. DataContext = SettingsViewModel. 화면은 바인딩만 (설정 관리 규칙 — TE 핸드오프 0절)
         숫자 칸: Enter 또는 다른 곳 클릭으로 확정, 잘못된 값은 원래 값으로 되돌리고 구역 안내에 표시 -->
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="KeyDown" Handler="Number_KeyDown"/>
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MaxWidth="1000" HorizontalAlignment="Left">

            <!-- 스크립트 편집 (4회차: 조합키 슬롯 추가 예정) -->
            <GroupBox Header="스크립트 편집">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="자동 백업: 마지막 백업 뒤 편집" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding AutoBackupEditsText, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="번이면 바로, 또는" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding AutoBackupMinutesText, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="분이 지났고 편집이 있으면 백업" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="백업 보관: 막마다 최근" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource Num}" Text="{Binding BackupCountText, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="개" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="자동 백업은 저장하지 않아도 에디터 내용을 exe 옆 Backups\{그룹}\ 에 씁니다 (편집이 없으면 쓰지 않음). 막을 연 뒤 첫 저장 때는 저장 전 원본도 보관합니다."/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="이 구역 기본값으로" Padding="8,1" Command="{Binding ResetScriptEditingCommand}"/>
                        <TextBlock Text="{Binding ScriptEditingNote}" Foreground="#FFC62828" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- 경로 (④: 게임 Resources 폴더 추가 예정) -->
            <GroupBox Header="경로">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="시나리오 폴더" VerticalAlignment="Center" Margin="0,3,10,3"
                               ToolTip="막 목록을 읽고 저장하는 게임 Assets\Resources\Scenario"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PathBox}" Text="{Binding ScenarioFolderText, Mode=OneWay}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,3">
                        <Button Content="변경…" Padding="8,1" Command="{Binding PickScenarioFolderCommand}"/>
                        <Button Content="열기" Padding="8,1" Margin="4,0,0,0" Command="{Binding OpenScenarioFolderCommand}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="게임 Spine 폴더" VerticalAlignment="Center" Margin="0,3,10,3"
                               ToolTip="게임으로 내보내기 대상 = 게임 Assets\Resources\Spine"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PathBox}" Text="{Binding GameSpineFolderText, Mode=OneWay}"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,3">
                        <Button Content="변경…" Padding="8,1" Command="{Binding PickGameSpineFolderCommand}"/>
                        <Button Content="열기" Padding="8,1" Margin="4,0,0,0" Command="{Binding OpenGameSpineFolderCommand}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Spine 데이터 폴더" VerticalAlignment="Center" Margin="0,3,10,3"
                               ToolTip="TE가 받은 Spine 세트 (보기만 — 바꾸려면 TE 재시작이 필요해 지금은 지원하지 않음)"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PathBox}" Text="{Binding SpineDataFolderText, Mode=OneWay}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="열기" Padding="8,1" Margin="0,3" HorizontalAlignment="Right"
                            Command="{Binding OpenSpineDataFolderCommand}"/>

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding PathNote}" Foreground="#FFC62828" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <!-- 설정 파일 -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="설정 파일 위치 열기" Padding="8,1" Command="{Binding OpenSettingsFolderCommand}"/>
                <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"
                           Text="{Binding SettingsFileText, StringFormat=설정 파일: {0}}"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
