<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCTheaterEditor</RootNamespace>
    <AssemblyName>SCTheaterEditor</AssemblyName>
    <Version>0.2.0</Version>
    <!-- publish 시 네이티브 dll까지 exe 하나에 포함 (RG와 같은 구성) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- 추가: exe 아이콘 (창에 Icon을 따로 지정하지 않으면 제목 표시줄·작업 표시줄도 이 아이콘을 씀) -->
    <ApplicationIcon>Resources\SCTheaterEditor.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 라이선스 탭에 표시할 고지 문구 (exe에 포함) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- 스크립트 탭 무대 페이지 (WebView2가 https://viewer.scsm/ 으로 읽음, 경로 = LogicalName에서 "viewer/" 뒤)
       디버그 빌드는 소스 폴더(Viewer\)에서 바로 읽으므로 JS 수정 후 다시 빌드할 필요 없음 (WpfStageHost) -->
  <ItemGroup>
    <EmbeddedResource Include="Viewer\stage.html" LogicalName="viewer/stage.html" />
    <EmbeddedResource Include="Viewer\js\bridge.js" LogicalName="viewer/js/bridge.js" />
    <EmbeddedResource Include="Viewer\js\actor.js" LogicalName="viewer/js/actor.js" />
    <EmbeddedResource Include="Viewer\js\stage.js" LogicalName="viewer/js/stage.js" />
    <EmbeddedResource Include="Viewer\js\main.js" LogicalName="viewer/js/main.js" />
    <EmbeddedResource Include="Viewer\js\audio.js" LogicalName="viewer/js/audio.js" />
    <EmbeddedResource Include="Viewer\lib\pixi.min.js" LogicalName="viewer/lib/pixi.min.js" />
    <EmbeddedResource Include="Viewer\lib\pixi-spine.js" LogicalName="viewer/lib/pixi-spine.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- 뷰어 (RG와 같은 패키지) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SCTheaterEditor.Core\SCTheaterEditor.Core.csproj" />
  </ItemGroup>

</Project>
