<Project Sdk="Microsoft.NET.Sdk">

  <!-- TE 핵심 로직 (화면 없음): 목록·다운로드·명명 규칙·립·애니메이션 규칙·설정·로그 + ViewModel (WPF에 의존하지 않아 테스트 가능) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCTheaterEditor</RootNamespace>
    <AssemblyName>SCTheaterEditor.Core</AssemblyName>
    <Version>0.2.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 유닛 분류 (아이돌 필터) -->
    <EmbeddedResource Include="Resources\IdolUnits.xml" LogicalName="IdolUnits.xml" />
    <!-- 립 기본값 (게임 프로젝트 Assets/Resources/Data/DefaultLipData.xml의 복사본 — 게임 쪽을 고치면 함께 갱신) -->
    <EmbeddedResource Include="Resources\DefaultLipData.xml" LogicalName="DefaultLipData.xml" />
    <!-- 추가: 스크립트 표 종류별 속성 팔레트 (원본 resource\Script\ScriptManual.xlsx) -->
    <EmbeddedResource Include="Resources\LineTypes.xml" LogicalName="LineTypes.xml" />
    <!-- 추가(4-2): 캐릭터 이름 (나중에 게임 Data/CharacterData.xml의 복사본으로) -->
    <EmbeddedResource Include="Resources\CharacterData.xml" LogicalName="CharacterData.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebP 텍스처 → PNG 변환 (MIT) -->
    <PackageReference Include="SkiaSharp" Version="3.*" />
    <!-- 추가: MVVM (ObservableObject, RelayCommand, Messenger) — MIT, UI 프레임워크에 의존하지 않음 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SCTheaterEditor.Tests" />
  </ItemGroup>

</Project>
