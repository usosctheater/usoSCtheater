<Window x:Class="SCSpineManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SC Spine Manager" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 변경: 리소스 탭에서 뷰어 탭으로 넘어가기 위해 이름 지정 -->
    <TabControl x:Name="MainTabs" Margin="6">

        <!-- ========== 다운로드 탭 ========== -->
        <TabItem Header="다운로드">
            <DockPanel Margin="6">

                <!-- 상단: 저장 폴더 / 목록 갱신 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="저장 폴더:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="SaveFolderBox" Width="380" IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <Button x:Name="OpenFolderButton" Content="폴더 열기" Margin="6,0,0,0" Padding="10,2" Click="OpenFolderButton_Click"/>
                    <Button x:Name="RefreshButton" Content="목록 갱신 (서버)" Margin="16,0,0,0" Padding="10,2" Click="RefreshButton_Click"
                            ToolTip="idollist + 아이돌별 dresslist를 받아 스냅샷을 갱신합니다 (요청 약 34회, 1초 간격)"/>
                    <!-- 추가: 다운로드 버튼 -->
                    <!-- 변경: 보이는 항목 받기 → 체크한 아이돌 받기 -->
                    <Button x:Name="DownloadCheckedButton" Content="체크한 아이돌 받기" Margin="16,0,0,0" Padding="10,2" Click="DownloadCheckedButton_Click"
                            ToolTip="아이돌 체크리스트에서 켠 아이돌의 세트 중 아직 받지 않은 것만 받습니다 (검색어와 무관)"/>
                    <Button x:Name="DownloadAllButton" Content="전체 받기" Margin="6,0,0,0" Padding="10,2" Click="DownloadAllButton_Click"
                            ToolTip="아직 받지 않은 모든 세트를 받습니다"/>
                    <!-- 변경: 취소 버튼을 목록 갱신·다운로드 공용 "중지"로 -->
                    <Button x:Name="CancelButton" Content="중지" Margin="6,0,0,0" Padding="10,2" IsEnabled="False" Click="CancelButton_Click"/>
                    <TextBlock x:Name="SnapshotText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <!-- 추가: 다운로드 진행 표시 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Width="420" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="DownloadProgress" Height="14" Minimum="0" Maximum="1" Value="0"/>
                </DockPanel>

                <!-- 요약 -->
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <!-- 하단: 로그 -->
                <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="120" Margin="0,6,0,0"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         FontFamily="Consolas"/>

                <!-- 건너뛴 항목 / 충돌 -->
                <Expander x:Name="SkippedExpander" DockPanel.Dock="Bottom" Header="건너뛴 항목 / 충돌" Margin="0,6,0,0">
                    <DataGrid x:Name="SkippedGrid" Height="150" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="90"/>
                            <DataGridTextColumn Header="idolId" Binding="{Binding IdolId}" Width="60"/>
                            <DataGridTextColumn Header="enzaId" Binding="{Binding EnzaId}" Width="100"/>
                            <DataGridTextColumn Header="의상명" Binding="{Binding DressName}" Width="*"/>
                            <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <!-- 추가: 아이돌 체크리스트 (켠 아이돌만 목록에 표시) -->
                <!-- 변경: 유닛 → 멤버 형태로 바뀌어 높이가 생기므로 테두리로 구분 -->
                <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,6">
                    <WrapPanel x:Name="IdolPanel"/>
                </Border>

                <!-- 필터 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" VerticalContentAlignment="Center"
                             ToolTip="아이돌·의상명·파일명·경로에서 검색 (공백으로 여러 단어)"/>
                </DockPanel>

                <!-- 받을 세트 목록 -->
                <DataGrid x:Name="SetGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <!-- 추가: 받기 상태 (대기 / 받는 중 / 완료 / 실패) -->
                        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="60"/>
                        <DataGridTextColumn Header="아이돌" Binding="{Binding IdolName}" Width="110"/>
                        <DataGridTextColumn Header="의상 종류" Binding="{Binding DressType}" Width="90"/>
                        <DataGridTextColumn Header="의상명" Binding="{Binding DressName}" Width="2*"/>
                        <DataGridTextColumn Header="그룹" Binding="{Binding Group}" Width="120"/>
                        <DataGridTextColumn Header="파일명" Binding="{Binding BaseName}" Width="1.5*"/>
                        <DataGridTextColumn Header="복사" Binding="{Binding CopyText}" Width="45"/>
                        <DataGridTextColumn Header="서버 경로" Binding="{Binding SourcePath}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ========== 추가: 리소스 탭 (받은 세트를 실제 폴더 구조대로 표시) ========== -->
        <TabItem Header="리소스">
            <Grid Margin="6">
                <!-- 변경: 맨 위 행에 아이돌 필터 (두 열에 걸쳐 표시) -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 추가: 아이돌 필터 (유닛 → 멤버) -->
                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,6">
                    <WrapPanel x:Name="ResourceIdolPanel"/>
                </Border>

                <!-- 왼쪽: 폴더 트리 -->
                <DockPanel Grid.Row="1" Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="ResourceRefreshButton" Content="새로 고침" Padding="10,2" Click="ResourceRefreshButton_Click"
                                ToolTip="매니페스트와 실제 파일을 다시 확인해 트리를 갱신합니다 (서버 요청 없음)"/>
                        <TextBlock x:Name="ResourceSummaryText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <!-- 추가: 최상위(SpineData)는 접지 않도록 트리 밖에 고정 표시 -->
                    <TextBlock x:Name="ResourceRootText" DockPanel.Dock="Top" FontWeight="Bold" Margin="2,0,0,4"/>
                    <!-- 변경: 세트·파일 더블클릭 → 뷰어에서 열기 -->
                    <TreeView x:Name="ResourceTree" SelectedItemChanged="ResourceTree_SelectedItemChanged"
                              MouseDoubleClick="ResourceTree_MouseDoubleClick"
                              PreviewKeyDown="ResourceTree_PreviewKeyDown"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Display}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"/>

                <!-- 오른쪽: 선택 항목 정보 + 텍스처 미리보기 -->
                <DockPanel Grid.Row="1" Grid.Column="2" Margin="6,0,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="ResourceOpenFolderButton" Content="탐색기에서 열기" Padding="10,2" IsEnabled="False"
                                Click="ResourceOpenFolderButton_Click"/>
                        <!-- 추가: 선택한 세트를 뷰어 탭에서 열기 -->
                        <Button x:Name="ResourceOpenViewerButton" Content="뷰어에서 열기" Padding="10,2" Margin="6,0,0,0" IsEnabled="False"
                                Click="ResourceOpenViewerButton_Click" ToolTip="세트·파일을 더블클릭하거나 스페이스바를 눌러도 열립니다"/>
                    </StackPanel>
                    <TextBox x:Name="ResourceInfoBox" DockPanel.Dock="Top" Height="230" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
                    <Border Margin="0,6,0,0" BorderBrush="LightGray" BorderThickness="1" Background="#FFEFEFEF">
                        <Image x:Name="ResourcePreview" Stretch="Uniform" Margin="4"/>
                    </Border>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ========== 추가: 뷰어 탭 ========== -->
        <TabItem x:Name="ViewerTab" Header="뷰어">
            <Grid Margin="6" PreviewKeyDown="ViewerTab_PreviewKeyDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 렌더링 (WebView2) -->
                <DockPanel Grid.Column="0">
                    <TextBlock x:Name="ViewerTitleText" DockPanel.Dock="Top" FontWeight="Bold" Margin="2,0,0,4"
                               Text="리소스 탭에서 세트를 더블클릭하면 여기에 표시됩니다"/>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" Margin="2,4,0,0"
                               Text="휠: 확대/축소 · 드래그: 이동 · 더블클릭: 화면 맞춤 · Space: 재생/일시정지 · R: 전체 초기화"/>
                    <!-- 추가: 재생 제어 (드래그 바는 일시정지 중에만 — SpineDebugScene과 같음) -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ViewerPauseButton" DockPanel.Dock="Left" Content="❚❚ 일시정지" Width="90" Padding="0,2"
                                Click="ViewerPauseButton_Click"/>
                        <TextBlock x:Name="ViewerTimeText" DockPanel.Dock="Right" Width="110" TextAlignment="Right"
                                   VerticalAlignment="Center" FontFamily="Consolas" Text="-"/>
                        <Slider x:Name="ViewerTimeSlider" Minimum="0" Maximum="1" Margin="8,0" VerticalAlignment="Center"
                                IsEnabled="False" ValueChanged="ViewerTimeSlider_ValueChanged"
                                ToolTip="일시정지 중에 드래그하면 모든 트랙을 각자 길이의 같은 비율 지점으로 옮깁니다 (기준: 기본 트랙)"/>
                    </DockPanel>
                    <Border BorderBrush="LightGray" BorderThickness="1">
                        <wv2:WebView2 x:Name="ViewerWeb"/>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                <!-- 변경: 오른쪽 조작 칸 — 설정 / 트랙 / 애니메이션 목록 / 트랙 상태 -->
                <DockPanel Grid.Column="2" Margin="6,0,0,0" Loaded="ViewerPanel_Loaded">
                    <TextBlock x:Name="ViewerInfoText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"/>

                    <GroupBox DockPanel.Dock="Top" Header="설정" Margin="0,0,0,6">
                        <StackPanel Margin="4">
                            <CheckBox x:Name="ViewerSingleTrackCheck" Content="바꾼 트랙만 교체 (디버그 씬 방식)"
                                      Checked="ViewerSingleTrackCheck_Changed" Unchecked="ViewerSingleTrackCheck_Changed"
                                      ToolTip="끄면 게임 방식: 애니메이션은 접두어 기준 트랙에 들어가고, 바뀔 때마다 전체 트랙을 처음부터 다시 재생합니다 (CGManager와 동일)"/>
                            <!-- 추가: 스킨 (cb_처럼 스킨이 여러 개인 데이터용, 하나뿐이면 비활성) -->
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="스킨:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ViewerSkinCombo" IsEnabled="False" SelectionChanged="ViewerSkinCombo_SelectionChanged"
                                          ToolTip="불러올 때 normal 스킨이 있으면 normal, 없으면 default가 아닌 첫 스킨을 고릅니다"/>
                            </DockPanel>
                            <!-- 추가: 립 재생 (게임 방식에서만, CGManager.LipSyncCoroutine과 같은 규칙) -->
                            <CheckBox x:Name="ViewerLipCheck" Content="립 재생 (게임 규칙)" Margin="0,8,0,0"
                                      Checked="ViewerLipSetting_Changed" Unchecked="ViewerLipSetting_Changed"
                                      ToolTip="Animation에 lip_이 있으면 그 립, 없으면 기본 트랙 애니메이션 이름과 DefaultLipData.xml로 말하는 중/멈춤 립을 정합니다"/>
                            <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                                <RadioButton x:Name="ViewerLipAlwaysRadio" GroupName="ViewerLipMode" Content="계속 말함" Margin="0,0,12,0"
                                             VerticalAlignment="Center" Checked="ViewerLipSetting_Changed"/>
                                <RadioButton x:Name="ViewerLipSecondsRadio" GroupName="ViewerLipMode" Content="말하다 멈춤:" VerticalAlignment="Center"
                                             Checked="ViewerLipSetting_Changed"/>
                                <TextBox x:Name="ViewerLipSecondsBox" Width="44" Margin="4,0,2,0" TextAlignment="Right"
                                         LostFocus="ViewerLipSecondsBox_LostFocus" KeyDown="ViewerLipSecondsBox_KeyDown"
                                         ToolTip="보이스 길이 (0.1 ~ 60초, Enter로 확정)"/>
                                <TextBlock Text="초" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="ViewerResetButton" DockPanel.Dock="Right" Content="전체 초기화 (R)" Padding="8,1" Click="ViewerResetButton_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="ViewerTrack0" GroupName="ViewerTrack" Content="0 기본" Margin="0,0,8,0" IsChecked="True" Checked="ViewerTrack_Checked"/>
                            <RadioButton x:Name="ViewerTrack1" GroupName="ViewerTrack" Content="1 face" Margin="0,0,8,0" Checked="ViewerTrack_Checked"/>
                            <RadioButton x:Name="ViewerTrack2" GroupName="ViewerTrack" Content="2 lip" Margin="0,0,8,0" Checked="ViewerTrack_Checked"/>
                            <RadioButton x:Name="ViewerTrack3" GroupName="ViewerTrack" Content="3 arm" Checked="ViewerTrack_Checked"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 아래쪽부터: 개발자 도구 / 트랙 상태 (Animation 문자열 내보내기는 씬 구성 탭으로 이관 예정) -->
                    <Button x:Name="ViewerDevToolsButton" DockPanel.Dock="Bottom" Content="개발자 도구" HorizontalAlignment="Left" Padding="8,1"
                            Margin="0,6,0,0" Click="ViewerDevToolsButton_Click" ToolTip="뷰어 페이지 오류 확인용"/>
                    <!-- 추가: 본 목록 (펼쳐 둔 동안 일시정지·시점 이동 때 갱신) -->
                    <Expander x:Name="ViewerBonesExpander" DockPanel.Dock="Bottom" Header="본 목록 (기본 자세와 다른 본)" Margin="0,6,0,0"
                              Expanded="ViewerBonesExpander_Expanded">
                        <DockPanel>
                            <Button x:Name="ViewerBonesRefreshButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Content="지금 자세로 갱신"
                                    Padding="8,1" Margin="0,4" Click="ViewerBonesRefreshButton_Click"/>
                            <ListBox x:Name="ViewerBoneList" Height="160" FontFamily="Consolas"/>
                        </DockPanel>
                    </Expander>
                    <TextBlock x:Name="ViewerTrackStateText" DockPanel.Dock="Bottom" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <ListBox x:Name="ViewerAnimList" FontFamily="Consolas"
                             PreviewMouseLeftButtonUp="ViewerAnimList_PreviewMouseLeftButtonUp" KeyDown="ViewerAnimList_KeyDown"/>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ========== 라이선스 탭 ========== -->
        <TabItem Header="라이선스">
            <TextBox x:Name="LicenseBox" Margin="6" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </TabItem>

    </TabControl>
</Window>
