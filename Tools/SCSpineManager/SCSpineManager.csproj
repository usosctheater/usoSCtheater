<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCSpineManager</RootNamespace>
    <AssemblyName>SCSpineManager</AssemblyName>
    <Version>0.1.0</Version>
    <!-- publish 시 네이티브 dll까지 exe 하나에 포함 (RG와 같은 구성) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- 라이선스 탭에 표시할 고지 문구 (exe에 포함) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <!-- 추가: 아이돌 필터의 유닛 분류 -->
    <EmbeddedResource Include="Resources\IdolUnits.xml" LogicalName="IdolUnits.xml" />
  </ItemGroup>

  <!-- 추가: WebP 텍스처 → PNG 변환 (MIT) -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.*" />
  </ItemGroup>

</Project>
