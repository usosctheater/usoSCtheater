<Window x:Class="SCResourceGrabber.TrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="추적 모드" Width="980" Height="600" MinWidth="480" MinHeight="240"
        Icon="app.ico" FontFamily="Malgun Gothic" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="4">
        <!-- 상단: 상태 + 필터 + 동작 -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="전체 선택/해제" Click="ToggleAll_Click"/>
                <Button Content="체크한 항목 저장" FontWeight="Bold" Click="SaveChecked_Click"/>
                <Button Content="목록 비우기" Click="Clear_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="2,0,8,0" FontWeight="Bold"/>
        </DockPanel>

        <!-- 분류 필터 (메인 목록과 같은 방식) -->
        <WrapPanel x:Name="CategoryPanel" DockPanel.Dock="Top" Margin="0,2"/>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#666" Margin="2,4,2,0" TextWrapping="Wrap"
                   Text="추적 시작 후 새로 받은 리소스와 재생된 오디오가 위에서부터 쌓이고, 다시 재생된 오디오는 맨 위로 올라옵니다. 이미 받아 둔 이미지를 게임이 다시 쓰면 나타나지 않습니다. 더블클릭: 상세 창 · 창을 닫으면 추적 종료"/>

        <ListView x:Name="TrackList" SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Background" Value="#DCF3E0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="재생" Width="75" DisplayMemberBinding="{Binding PlayingText}"/>
                    <GridViewColumn Header="미리보기" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Resource.Thumbnail}" Width="56" Height="40" Stretch="Uniform"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="파일" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="종류" Width="100" DisplayMemberBinding="{Binding CategoryLabel}"/>
                    <GridViewColumn Header="구분" Width="70" DisplayMemberBinding="{Binding SourceText}"/>
                    <GridViewColumn Header="횟수" Width="40" DisplayMemberBinding="{Binding PlayCountText}"/>
                    <GridViewColumn Header="마지막 재생" Width="75" DisplayMemberBinding="{Binding LastPlayedText}"/>
                    <GridViewColumn Header="받은 시각" Width="75" DisplayMemberBinding="{Binding FirstSeenText}"/>
                    <GridViewColumn Header="크기" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="URL" Width="400" DisplayMemberBinding="{Binding Url}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
