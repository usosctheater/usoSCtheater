<Window x:Class="SCResourceGrabber.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다운로드" Width="1200" Height="760" MinWidth="720" MinHeight="420"
        Icon="app.ico" FontFamily="Malgun Gothic" FontSize="12">
    <Window.Resources>
        <!-- 투명 영역 확인용 체크무늬 배경 (상세 창과 같음) -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L16,0 16,16 0,16Z"/>
                    <GeometryDrawing Brush="#E6E6E6" Geometry="M0,0 L8,0 8,8 0,8Z M8,8 L16,8 16,16 8,16Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="4">
        <!-- ===================== 하단: 옵션 · 저장 ===================== -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <WrapPanel>
                <TextBlock Text="이미지:" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0,4,0"/>
                <CheckBox x:Name="PngCheck" Content="PNG로 변환" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="webp·jpg 등을 PNG로 저장 (끄면 원본 형식. 잘라내기·정렬을 켜면 항상 PNG)"/>
                <CheckBox x:Name="TrimCheck" Content="투명 여백 잘라내기" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="SquareCheck" Content="정사각형 가운데 정렬" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <TextBlock Text="여백" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="PaddingBox" Width="40" VerticalContentAlignment="Center" TextAlignment="Right"
                         LostFocus="PaddingBox_LostFocus" KeyDown="PaddingBox_KeyDown"
                         ToolTip="긴 변 기준 % (사인 6, 로고 0). 0이면 여백 없음"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBlock Text="· 이미지가 아닌 항목은 이름만 바꿔 원본 그대로 저장" Foreground="#888" VerticalAlignment="Center"/>
            </WrapPanel>
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="저장 폴더" VerticalAlignment="Center" Margin="2,0,4,0"/>
                <CheckBox x:Name="OverwriteCheck" DockPanel.Dock="Right" Content="같은 이름 덮어쓰기"
                          Checked="Option_Changed" Unchecked="Option_Changed"/>
                <Button DockPanel.Dock="Right" Content="열기" Click="OpenFolder_Click"/>
                <Button DockPanel.Dock="Right" Content="찾기…" Click="BrowseFolder_Click"/>
                <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Margin="2" LostFocus="FolderBox_LostFocus"/>
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="SaveAllButton" Content="모두 저장" FontWeight="Bold" Click="SaveAll_Click"/>
                <Button DockPanel.Dock="Right" Content="목록 비우기" Click="ClearList_Click"/>
                <Button DockPanel.Dock="Right" Content="목록에서 빼기" Click="Remove_Click" ToolTip="선택한 행 빼기 (Delete)"/>
                <Button DockPanel.Dock="Right" Content="이름 목록 편집" Click="EditNames_Click"
                        ToolTip="자동 완성 후보 names.txt를 메모장으로 엽니다 (고친 뒤 [다시 읽기])"/>
                <Button DockPanel.Dock="Right" Content="다시 읽기" Click="ReloadNames_Click"/>
                <TextBlock x:Name="StatusText" Foreground="#666" VerticalAlignment="Center" Margin="2,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== 왼쪽: 목록 ===================== -->
            <ListView x:Name="ItemList" Grid.Column="0" SelectionMode="Extended"
                      SelectionChanged="ItemList_SelectionChanged" KeyDown="ItemList_KeyDown"
                      ToolTip="행을 고르면 오른쪽에 미리보기 · 이름 칸에 입력 후 Enter로 다음 항목">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Index}"/>
                        <GridViewColumn Header="미리보기" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Thumbnail}" Width="56" Height="40" Stretch="Uniform"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="저장 이름" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="NameCell" Text="{Binding SaveNameText}" FontWeight="Bold"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SaveName}" Value="">
                                            <Setter TargetName="NameCell" Property="Foreground" Value="#AAA"/>
                                            <Setter TargetName="NameCell" Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="상태" Width="90" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="종류" Width="80" DisplayMemberBinding="{Binding CategoryLabel}"/>
                        <GridViewColumn Header="원본" Width="220" DisplayMemberBinding="{Binding OriginalName}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- ===================== 오른쪽: 미리보기 · 이름 ===================== -->
            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="저장 이름 (확장자 제외 · Enter: 다음 항목 · 비우면 원본 이름)" Foreground="#555" Margin="2,0,0,2"/>
                    <ComboBox x:Name="NameBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                              FontSize="16" Padding="4,3" PreviewKeyDown="NameBox_PreviewKeyDown"/>
                    <TextBlock x:Name="NameHint" Foreground="#888" Margin="2,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="PreviewInfo" DockPanel.Dock="Top" Foreground="#555" Margin="2,0,0,4" TextTrimming="CharacterEllipsis"/>
                <Border Background="{StaticResource Checker}" BorderBrush="#CCC" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PreviewEmpty" Text="(미리보기 없음)" Foreground="#999" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
