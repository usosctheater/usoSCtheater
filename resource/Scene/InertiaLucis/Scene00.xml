	<Line Type="TEXT" Name="메이" Text="아하하, 후유코쨩. 일단 진정하자~" Voice="OT053" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="아사히, 너 잡히기만 해!" Voice="OT054" SpeakerType="1"/>
