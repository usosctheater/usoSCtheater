	<Line Type="TEXT" Name="후유코" Text="어제 이야기했잖아, 아사히쨩?" Voice="OT002" CG="fuyuko_normal_4" Position="center" Animation="smile1" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="이번에 개장하는 극장에 대한 PR 오퍼래." Voice="OT003" CG="mei_normal_8" Position="right" Animation="wait2" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="헤에-" Voice="OT004" CG="asahi_normal_sr2" Position="left" Animation="wait3 face_wait lip_surp" SpeakerType="1"/>
	<Line Type="CGGROUP" Name="straylight" CG="asahi_normal_sr2" Position="left" Animation="skill1"/>
	<Line Type="CGGROUP" Name="straylight" CG="fuyuko_normal_4" Position="center" Animation="skill1"/>
	<Line Type="CGGROUP" Name="straylight" CG="mei_normal_8" Position="right" Animation="skill1"/>
	<Line Type="TEXT" Name="후유코" Text="두 사람 다 준비 됐어? 인사할게?" Voice="OT005" CG="fuyuko_normal_4" Position="center" Animation="smile2" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="안녕하세요. 저희는," Voice="OT006" SpeakerType="1"/>
	<Line Type="TEXT" Name="스트레이라이트" Text="스트레이라이트입니다!" Voice="OT007 OT008 OT009" CG="straylight"/>
	<Line Type="TEXT" CG="none" SpeakerType="0"/>
	<Line Type="TEXT" Name="후유코" Text="처음에 메이쨩이 말했듯이, 이번에 새롭게 개장하신다는 소식을 듣고\n축하 영상을 보내드립니다." Voice="OT010" CG="fuyuko_normal_4" Position="center" Animation="smile1" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="개장 축하드립니다~" Voice="OT011" CG="fuyuko_normal_4" Position="center" Animation="smile4"/>
	<Line Type="TEXT" Name="아사히" Text="축하드림다~" Voice="OT012" CG="asahi_normal_sr2" Position="left" Animation="smile2 face_wait lip_surp" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="축하드립니다." Voice="OT013" CG="mei_normal_8" Position="right" Animation="smile3 face_smile2 lip_smile1" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="개장하고 가장 첫 상영은, \n저희 스트레이라이트가 출연한 InertiaLucis라는 작품이라고 합니다." Voice="OT014" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="이 작품은 빛의…" Voice="OT015" CG="asahi_normal_sr2" Position="left" Animation="why face_anger lip_anger" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="이거 뭐라고 읽는 검까?" Voice="OT016" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="'관성' 이라고 읽는 거야." Voice="OT017" CG="fuyuko_normal_4" Position="center" Animation="smile1 face_serious" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="(이 자식, 그렇게 대본 읽어두라고 했는데…!)" Voice="OT018" CG="none" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="관성이라는 뜻이라고 함다." Voice="OT019" CG="asahi_normal_sr2" Position="left" Animation="wait3 face_wait lip_surp" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="아, 그러고보니 스시 1접시 할 때의 한자랑 닮았슴다." Voice="OT020" CG="asahi_normal_sr2" Position="left" Animation="think1" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="오, 확실히…" Voice="OT021" CG="mei_normal_8" Position="right" Animation="surp2 lip_smile2" SpeakerType="1"/>
	<Line Type="SE" Track="se_ira" Volume="0.3"/>
	<Line Type="BREAK" Effect="clean" Duration="0.2"/>
	<Line Type="TEXT" CG="none" SpeakerType="0"/>
	<Line Type="TEXT" Name="후유코" Text="빛에는 원래 관성이 없는데, 빛의 관성이라니 무슨 의미일지 궁금하네요~" Voice="OT022" CG="fuyuko_normal_4" Position="left" Animation="smile4" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="아, 후유코쨩이 제 대사 뺏어갔슴다." Voice="OT023" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="두 사람은 촬영하면서 기억나는 장면이라던가, 있어?" Voice="OT024" CG="fuyuko_normal_4" Position="left" Animation="think face_smile lip_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="예전에 운동회에 나갔을 땐 서로 다른 팀이었는데," Voice="OT025" CG="mei_normal_8" Position="right" Animation="smile2 face_serious" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="이번에는 같이 뛸 수 있어서 기뻤어." Voice="OT026" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="뛰는 장면을 찍을 때, 두 시간 넘게 계속 뛰니까 힘들었슴다." Voice="OT027" CG="asahi_normal_sr2" Position="center" Animation="anger1" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="완성된 장면을 봤을 때, 뛰는 건 10분도 안나왔는데…" Voice="OT028" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="아사히쨩, 좋았던 기억은…?" Voice="OT029" CG="fuyuko_normal_4" Position="left" Animation="surp1 face_bitter_smile lip_bitter_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="음…" Voice="OT030" CG="asahi_normal_sr2" Position="center" Animation="think1" SpeakerType="1"/>
	<Line Type="BREAK" Duration="0.5"/>
	<Line Type="TEXT" Name="아사히" Text="아, 끝나고 먹은 소고기가 맛있었슴다!" Voice="OT031" CG="asahi_normal_sr2" Position="center" Animation="smile3 lip_surp" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="......" CG="none" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="후, 후유도 예전에 대운동회에 나갔을 때의 생각이 났어." Voice="OT032" CG="fuyuko_normal_4" Position="center" Animation="smile4 face_bitter_smile lip_bitter_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="그 때와 비교하면, 지금은 굉장히 많은 게 달라졌구나… 하고." Voice="OT033" CG="fuyuko_normal_4" Position="center" Animation="think face_smile lip_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="팀적으로도, 개인적으로, 굉장히 많은 게 달라지고" Voice="OT034" CG="fuyuko_normal_4" Position="center" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="어떤 건 전혀 달라지지 않았구나, 하고." Voice="OT035" CG="fuyuko_normal_4" Position="center" Animation="smile1" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="만약 그 시절의 대운동회 방송을 기억하시는 분들이 계신다면, \n이번의 저희의 모습과 비교해서 보시는 것도 재밌을 것 같아요!" Voice="OT036" CG="fuyuko_normal_4" Position="center" Animation="smile4" SpeakerType="1"/>
	<Line Type="TEXT" Name="프로듀서" Text="(슬슬 마무리하자)" SpeakerType="2"/>
	<Line Type="TEXT" Name="아사히" Text="그래도, 재밌었슴다!" Voice="OT037" CG="asahi_normal_sr2" Position="left" Animation="smile3 lip_surp" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="응, 그렇네." Voice="OT038" CG="mei_normal_8" Position="right" Animation="surp2 face_wait lip_smile2" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="네, 저희가 이렇게 재미있게 촬영한 작품과, 이번에 새로 개장하는 극장까지" Voice="OT039" CG="fuyuko_normal_4" Position="center" Animation="skill1 face_smile lip_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="모두들, 많은 관심 부탁드립니다~" Voice="OT040" SpeakerType="1"/>
	<Line Type="TEXT" Name="아사히" Text="구독이랑, 좋아요도 부탁드림다~" Voice="OT041" CG="asahi_normal_sr2" Position="left" Animation="smile2 lip_surp" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="아사히쨩? 유튜브 같은 게 아니니까…!" Voice="OT042" CG="fuyuko_normal_4" Position="center" Animation="shrug face_bitter_smile lip_bitter_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="메이" Text="댓글도 많이 달아주세요." Voice="OT043" CG="mei_normal_8" Position="right" Animation="smile3 face_smile2 lip_smile1" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="정말~ 메이쨩까지!" Voice="OT044" CG="fuyuko_normal_4" Position="center" Animation="surp1 face_bitter_smile lip_bitter_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="후유코" Text="아무튼! 지금까지," Voice="OT045" CG="fuyuko_normal_4" Position="center" Animation="anger3 face_smile lip_smile" SpeakerType="1"/>
	<Line Type="TEXT" Name="스트레이라이트" Text="스트레이라이트였습니다!" Voice="OT046 OT047 OT048" CG="straylight"/>
	<Line Type="TRANSITION" Effect="normal"/>
