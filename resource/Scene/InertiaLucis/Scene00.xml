	<Line Type="TEXT" Name="후유코" Text="아사히, 후유가 어제부터 대본 훑어보라고 했지!" Voice="OT050" SpeakerType="1"/>
	<Line Type="SE" Duration="0.8" Track="se_rouka_run" Volume="1"/>
